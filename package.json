{
  "name": "agriva-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "payload:types": "payload generate:types --config src/payload.config.ts",
    "payload:importmap": "payload generate:importmap --config src/payload.config.ts",
    "db:migrate:create": "payload migrate:create --config src/payload.config.ts",
    "db:migrate": "payload migrate --config src/payload.config.ts",
    "admin:bootstrap": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "next": "15.4.11",
    "payload": "3.84.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.4.11",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=20.9.0" },
  "packageManager": "pnpm@11.25.0"
